generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marketId String?
  market   Market? @relation(fields: [marketId], references: [id])

  ownedMarket Market? @relation("MarketOwner")
}

model Market {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String @unique
  owner   User   @relation("MarketOwner", fields: [ownerId], references: [id])

  users                  User[]
  products               Product[]
  sales                  ProductSale[]
  cashMovements          CashMovement[]
  cashSessions           CashSession[]
  categories             Category[]
  customers              Customer[]
  employees              Employee[]
  paymentSettings        PaymentSetting[]
  onlineOrders           OnlineOrder[]
  cashClosingCorrections CashClosingCorrection[]
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STOCK
}

model Product {
  id       String @id @default(uuid())
  marketId String

  name     String
  sku      String?
  barcode  String?
  category String?
  brand    String?

  isActive Boolean @default(true)

  salePrice          Float
  cost               Float   @default(0)
  useSameOnlinePrice Boolean @default(true)
  onlinePrice        Float   @default(0)

  stock          Int     @default(0)
  minStock       Int     @default(0)
  allowBackorder Boolean @default(false)

  isVisibleOnline Boolean @default(false)
  description     String?
  imageUrl        String?
  isFeatured      Boolean @default(false)
  allowPickup     Boolean @default(true)
  allowDelivery   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  market    Market     @relation(fields: [marketId], references: [id])
  saleItems SaleItem[]

  @@index([marketId])
}

model ProductSale {
  id            String     @id @default(uuid())
  marketId      String
  userId        String
  cashSessionId String?
  customerName  String?
  paymentMethod String
  discount      Float      @default(0)
  subtotal      Float
  total         Float
  status        SaleStatus @default(COMPLETED)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  market      Market       @relation(fields: [marketId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  items       SaleItem[]

  @@index([marketId])
  @@index([cashSessionId])
  @@index([createdAt])
}

model SaleItem {
  id          String @id @default(uuid())
  saleId      String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  total       Float

  sale    ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model CashMovement {
  id            String           @id @default(uuid())
  marketId      String
  userId        String
  type          CashMovementType
  amount        Float
  note          String?
  createdAt     DateTime         @default(now())
  cashSessionId String?

  market      Market       @relation(fields: [marketId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])

  @@index([marketId])
  @@index([createdAt])
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL
}

model CashSession {
  id                String            @id @default(uuid())
  marketId          String
  userId            String
  operatorName      String?
  openingAmount     Float
  closingAmount     Float?
  expectedCash      Float?
  difference        Float?
  closingCode       String?           @unique
  closingStatus     String?
  grossSales        Float?
  discounts         Float?
  netSales          Float?
  discrepancyReason String?
  discrepancyNote   String?
  actionTaken       String?
  finalNote         String?
  countHistory      Json?
  paymentSummary    Json?
  status            CashSessionStatus @default(OPEN)
  openedAt          DateTime          @default(now())
  closedAt          DateTime?
  revision          Int               @default(0)

  market      Market                  @relation(fields: [marketId], references: [id])
  movements   CashMovement[]
  sales       ProductSale[]
  corrections CashClosingCorrection[]

  @@index([marketId])
  @@index([status])
}

model CashClosingCorrection {
  id                      String   @id @default(uuid())
  marketId                String
  cashSessionId           String
  authorizedManagerId     String?
  authorizedManagerName   String
  requestedByUserId       String
  requestedByName         String
  previousClosingAmount   Float
  correctedClosingAmount  Float
  previousDifference      Float
  correctedDifference     Float
  previousClosingStatus   String?
  correctedClosingStatus  String
  previousPaymentSummary  Json
  correctedPaymentSummary Json
  reason                  String
  note                    String?
  createdAt               DateTime @default(now())

  market            Market      @relation(fields: [marketId], references: [id])
  cashSession       CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  authorizedManager Employee?   @relation(fields: [authorizedManagerId], references: [id], onDelete: SetNull)

  @@index([marketId])
  @@index([cashSessionId, createdAt])
  @@index([authorizedManagerId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model Category {
  id        String   @id @default(uuid())
  marketId  String
  name      String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  market Market @relation(fields: [marketId], references: [id])

  @@unique([marketId, name])
  @@index([marketId])
}

model Customer {
  id        String   @id @default(uuid())
  marketId  String
  name      String
  phone     String?
  email     String?
  document  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  market Market @relation(fields: [marketId], references: [id])

  @@index([marketId])
}

model Employee {
  id        String       @id @default(uuid())
  marketId  String
  name      String
  role      EmployeeRole @default(CASHIER)
  pin       String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  market                 Market                  @relation(fields: [marketId], references: [id])
  cashClosingCorrections CashClosingCorrection[]

  @@index([marketId])
}

enum EmployeeRole {
  CASHIER
  MANAGER
}

model PaymentSetting {
  id        String   @id @default(uuid())
  marketId  String
  type      String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  market Market @relation(fields: [marketId], references: [id])

  @@unique([marketId, type])
  @@index([marketId])
}

model OnlineOrder {
  id               String            @id @default(uuid())
  marketId         String
  orderNumber      String
  customerName     String
  customerPhone    String?
  customerEmail    String?
  customerDocument String?
  deliveryType     String            @default("PICKUP")
  address          String?
  paymentMethod    String
  status           OnlineOrderStatus @default(PENDING)
  subtotal         Float
  discount         Float             @default(0)
  deliveryFee      Float             @default(0)
  total            Float
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  market Market            @relation(fields: [marketId], references: [id])
  items  OnlineOrderItem[]

  @@unique([marketId, orderNumber])
  @@index([marketId])
  @@index([createdAt])
}

model OnlineOrderItem {
  id          String @id @default(uuid())
  orderId     String
  productName String
  quantity    Int
  unitPrice   Float
  total       Float

  order OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OnlineOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
